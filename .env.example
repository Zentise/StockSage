# Copy to .env. Everything is optional except where noted.

# AI research notes (free key at console.groq.com). Without it, notes are off and say so.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Leave empty for a local SQLite file. Set to Postgres when deploying.
DATABASE_URL=

# Comma-separated sites allowed to call the API from a browser.
# ALLOWED_ORIGINS=https://your-site.example

# Extra exchange holidays, YYYY-MM-DD,YYYY-MM-DD
# STOCKSAGE_NSE_HOLIDAYS=

# ---- Private features (journal, alerts, AI chat and debate) ----
# On a public site, set a long random key (python -c "import secrets; print(secrets.token_urlsafe(32))").
# The private pages then ask for it. Leave empty for local use: nothing is locked.
OWNER_TOKEN=

# Telegram alerts and the 8:45 morning brief. Talk to @BotFather for a token, then message your bot
# and open https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 1 = also message about setups that have not beaten random stocks (off by default).
ALERT_UNPROVEN=0

# How much of India the scan covers: 50 (default), 100, 200 or 500. More means many more price requests.
STOCKSAGE_INDIA_UNIVERSE=50
