  "/stock/{ticker}": {
   "get": {
    "summary": "Get Stock",
    "operationId": "get_stock_stock__ticker__get",
    "parameters": [
     {
      "name": "ticker",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^[A-Z0-9^&.=\\-]{1,20}$",
       "title": "Ticker"
      }
